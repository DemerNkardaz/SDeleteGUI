{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Release",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "-c",
                "Release"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build Debug",
            "type": "process",
            "command": "dotnet",
            "args": [
                "build",
                "-c",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Run",
            "type": "process",
            "command": "dotnet",
            "args": [
                "run"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Clean",
            "type": "process",
            "command": "dotnet",
            "args": [
                "clean"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
