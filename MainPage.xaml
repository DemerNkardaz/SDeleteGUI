<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SDeleteGUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SDeleteGUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12"
      Background="Transparent"
      AllowDrop="True"
      DragOver="RootGrid_DragOver"
      Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <!-- Tabs -->
            <RowDefinition Height="Auto"/>
            <!-- Common options -->
            <RowDefinition Height="Auto"/>
            <!-- Console output -->
            <RowDefinition Height="*" MinHeight="150"/>
            <!-- Status bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Tabs -->
        <Pivot Grid.Row="0" x:Name="MainPivot" Padding="0" Margin="-12,0,-12,0"
              SelectionChanged="OnPivotSelectionChanged">
            <!-- File deletion tab -->
            <PivotItem x:Uid="FileDeletionTab">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Height="270"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" x:Uid="PathsHeader" FontWeight="SemiBold"/>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="PathsPanel" Spacing="8">
                                    <TextBlock x:Name="EmptyPathsHint"
                                              x:Uid="EmptyPathsHint"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ScrollViewer>

                          <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                              <Button x:Name="AddFilesButton" x:Uid="AddFilesButton" Click="AddFiles_Click" Width="144"/>
                              <Button x:Name="AddFolderButton" x:Uid="AddFolderButton" Click="AddFolder_Click" Width="144"/>
                              <Button x:Name="ClearPathsButton" x:Uid="ClearPathsButton" Click="ClearPathsButton_Click" Width="96"/>
                          </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File deletion flags -->
                    <Border Grid.Row="1"
                            Height="64"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                      <StackPanel Orientation="Horizontal" Spacing="24" VerticalAlignment="Center">
                          <CheckBox x:Name="RecurseCheckBox" x:Uid="RecurseCheckBox"
                                    Checked="OnOptionChanged" Unchecked="OnOptionChanged"/> <!-- -s -->
                          <CheckBox x:Name="RemoveReadOnlyCheckBox" x:Uid="RemoveReadOnlyCheckBox"
                                    Checked="OnOptionChanged" Unchecked="OnOptionChanged"/> <!-- -r -->
                      </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>

            <!-- Clean free space tab -->
            <PivotItem x:Uid="CleanFreeSpaceTab">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Drives list -->
                    <Border Grid.Row="0"
                            Height="270"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Grid RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" x:Uid="DrivesHeader" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Grid.Row="0" Grid.Column="1"
                                    x:Name="RefreshDrivesButton"
                                    x:Uid="RefreshDrivesButton"
                                    Click="RefreshDrivesButton_Click"/>

                            <GridView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                      x:Name="DrivesGridView"
                                      SelectionMode="Multiple"
                                      IsItemClickEnabled="False"
                                      SelectionChanged="OnDrivesSelectionChanged"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <GridView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <ItemsWrapGrid Orientation="Horizontal" ItemWidth="118" ItemHeight="96"/>
                                    </ItemsPanelTemplate>
                                </GridView.ItemsPanel>
                                <GridView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="102" Height="82" Padding="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding DriveLetter}"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Top"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <FontIcon Grid.Row="0"
                                                      Glyph="{Binding Glyph}"
                                                      FontSize="26"
                                                      HorizontalAlignment="Center"
                                                      Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="1"
                                                      Text="{Binding DisplayName}"
                                                      TextAlignment="Center"
                                                      TextWrapping="NoWrap"
                                                      FontSize="12"
                                                      Margin="0,4,0,0"/>

                                            <TextBlock Grid.Row="2"
                                                      Text="{Binding CapacityText}"
                                                      TextAlignment="Center"
                                                      FontSize="10"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                                            <ProgressBar Grid.Row="3"
                                                        Value="{Binding UsedPercent}"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Height="4"
                                                        Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </GridView.ItemTemplate>
                            </GridView>
                        </Grid>
                    </Border>

                    <!-- Clean mode flags -->
                    <Border Grid.Row="1"
                            Height="64"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                      <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                          <TextBlock x:Uid="CleanModeLabel" VerticalAlignment="Center"/>
                          <RadioButton x:Name="ZeroFillRadio" x:Uid="ZeroFillRadio" GroupName="CleanMode" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/> <!-- -z -->
                          <RadioButton x:Name="CleanFreeRadio" x:Uid="CleanFreeRadio" GroupName="CleanMode" IsChecked="True" Checked="OnOptionChanged" Unchecked="OnOptionChanged"/> <!-- -c -->
                      </StackPanel>
                    </Border>
                </Grid>
            </PivotItem>
        </Pivot>

        <!-- Common options -->
        <Border Grid.Row="1"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12">
            <StackPanel Spacing="12">

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" x:Uid="SdeleteFolderLabel" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                            x:Name="SdeleteFolderTextBox"
                            x:Uid="SdeleteFolderTextBox"
                            TextChanged="OnSdeleteFolderChanged"/>
                    <Button Grid.Column="2"
                            x:Name="BrowseSdeleteFolderButton"
                            x:Uid="BrowseSdeleteFolderButton"
                            MinWidth="120"
                            Click="BrowseSdeleteFolderButton_Click"/>
                </Grid>

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0"
                              x:Name="Use64BitCheckBox" x:Uid="Use64BitCheckBox"
                              VerticalAlignment="Center"
                              Checked="OnOptionChanged" Unchecked="OnOptionChanged"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <TextBlock x:Uid="PassesLabel" VerticalAlignment="Center"/>
                        <NumberBox x:Name="PassesNumberBox"
                                  Value="3"
                                  Minimum="1"
                                  SpinButtonPlacementMode="Inline"
                                  Width="160"
                                  ValueChanged="OnPassesChanged"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            x:Name="RunButton"
                            Click="RunButton_Click"
                            MinWidth="120"
                            VerticalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Console output -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <TextBox x:Name="OutputTextBox"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    BorderThickness="0"
                    Background="White"
                    Foreground="Black"
                    FontFamily="Consolas"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"/>
        </Border>

        <ContentDialog x:Name="ConfirmDialog"
                      x:Uid="ConfirmDialog"
                      DefaultButton="Close"
                      IsPrimaryButtonEnabled="False">
            <TextBlock x:Name="ConfirmDialogText" TextWrapping="Wrap"/>
        </ContentDialog>

        <!-- Status bar -->
        <Border Grid.Row="3"
                Padding="12,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <FontIcon x:Name="StatusIcon"
                          Grid.Column="0"
                          Glyph="&#xE945;"
                          FontSize="14"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          VerticalAlignment="Center"/>

                <ProgressRing x:Name="StatusProgressRing"
                              Grid.Column="1"
                              Width="14"
                              Height="14"
                              Margin="8,0,0,0"
                              IsActive="False"
                              Visibility="Collapsed"
                              VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusTimerText"
                           Grid.Column="2"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <InfoBar x:Name="SdeleteNotFoundInfoBar"
                         Grid.Column="2"
                         Severity="Error"
                         IsOpen="False"
                         IsClosable="False"
                         IsIconVisible="True"
                         Margin="16,0"
                         VerticalAlignment="Center"/>

                <TextBlock x:Name="StatusVersionText"
                           Grid.Column="3"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <HyperlinkButton x:Name="StatusAuthorLink"
                                 Grid.Column="4"
                                 NavigateUri="https://github.com/DemerNkardaz"
                                 Padding="4,0"
                                 FontSize="12"
                                 VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Page>
